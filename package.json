{
  "name": "redact-me",
  "private": true,
  "version": "0.1.0",
  "description": "Redact Me development workspace",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "dev:backend": "backend/.venv/bin/python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
